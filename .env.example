# Copy to .env and fill in. Both services (voice and bridge) read this file.

# ---- Required ----

# A long random secret shared by the voice server, the bridge and the OpenClaw skill.
# Make one with: openssl rand -hex 24
API_TOKEN=

# Your Zoom app with the Meeting SDK turned on (marketplace.zoom.us > Develop > Build App >
# General App > Embed > Meeting SDK). Copy its Client ID and Client Secret.
ZOOM_SDK_CLIENT_ID=
ZOOM_SDK_CLIENT_SECRET=

# ---- The brain ----

# The OpenClaw Gateway's chat completions endpoint. Turn it on in OpenClaw with
#   openclaw config set gateway.http.endpoints.chatCompletions.enabled true
# Inside Docker, "host.docker.internal" is the computer running Docker.
LLM_URL=http://host.docker.internal:18789/v1/chat/completions
# Your Gateway token (openclaw config get gateway.auth.token).
LLM_API_KEY=
# openclaw:<agentId>. The call goes through this agent, so it can use your other agents and tools.
LLM_MODEL=openclaw:main
# Any other OpenAI-compatible endpoint works too, e.g. Ollama:
#   LLM_URL=http://host.docker.internal:11434/v1/chat/completions
#   LLM_MODEL=llama3.1:8b

AI_NAME=Assistant
GREETING=Hey, it's your assistant. What's up?
# SYSTEM_PROMPT=...   (the default asks for short spoken replies and <hangup/> at the end)

# ---- Which meeting the bot uses ----

# Easiest: your personal meeting link (Zoom app > Meetings > Personal Room > Copy invitation;
# the link with /j/<number>?pwd=...). The AI calls you here, and "join my meeting" joins it.
# Turn on "Allow participants to join before host" for it, so the bot can wait for you.
# Without the Zoom API below, the host (you) gets an "allow recording?" prompt each call:
# the bot can only hear the meeting once you click Allow.
PERSONAL_MEETING_URL=

# Always-on: the bot stays in this meeting all the time, and you join it whenever you want to
# talk. It greets you when you arrive, stays when you leave, and rejoins on its own if Zoom ends
# the meeting. "Call me" sends you this link instead of making a new one. Can be the same link
# as PERSONAL_MEETING_URL. The meeting needs "join before host" on and the waiting room off.
# Anyone with this link can talk to your agent, so keep it private.
ALWAYS_ON_MEETING_URL=

# Better: a Server-to-Server OAuth app on your Zoom account (marketplace.zoom.us > Develop >
# Build App > Server-to-Server OAuth). The bot then makes a fresh meeting for every call and
# can listen without the recording prompt. Scopes: create meetings, read meetings, and read a
# meeting's local recording join token.
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# Joining a meeting hosted by someone else's Zoom account needs an "on behalf of" token
# (required by Zoom since March 2026). Get one from Zoom's API (GET /v2/users/me/token?type=onbehalf,
# with a user OAuth app that has the user:read:token scope). It lasts about two hours.
# You can also pass one per call: POST /api/join {"link": ..., "obf_token": ...}.
ZOOM_OBF_TOKEN=

# Only when the bridge runs on a different computer from the voice server (see the README):
# VOICE_URL=ws://<voice server's address>:8090/bridge

# How long the bot waits in a meeting for you before giving up (seconds).
JOIN_TIMEOUT=180

# Optional: a push notification with the join link when the AI calls you. Any URL that accepts
# a plain-text POST works; with ntfy (free app), use https://ntfy.sh/<a-long-random-topic-name>.
NOTIFY_URL=

# Optional: join automatically when one of your meetings starts. Needs this server reachable
# from the internet (e.g. a Cloudflare or Tailscale Funnel tunnel to port 8090), and an Event
# Subscription for "Meeting has started" pointed at https://<your-host>/zoom/webhook in a Zoom app.
# Comma-separated meeting numbers, optionally with :passcode.
ZOOM_WEBHOOK_SECRET=
AUTO_JOIN_MEETINGS=

# ---- Speech ----

# Local and free by default. Models download into ./data on first use.
STT_BACKEND=faster-whisper
WHISPER_MODEL=base.en
TTS_BACKEND=piper
PIPER_VOICE=en_US-lessac-medium
# Or any OpenAI-compatible speech API:
#   STT_BACKEND=openai   STT_URL=...  STT_API_KEY=...  STT_MODEL=whisper-1
#   TTS_BACKEND=openai   TTS_URL=...  TTS_API_KEY=...  TTS_MODEL=gpt-4o-mini-tts  TTS_VOICE=alloy

# ---- Tuning ----

# Say a filler ("One sec.") if the brain takes longer than this; give up after LLM_TIMEOUT.
FILLER_DELAY=2.5
LLM_TIMEOUT=30
# Turn-taking: how long a pause ends your turn, and how long you must talk to interrupt.
SILENCE_MS=700
BARGE_IN_MS=300
# LOG_LEVEL=DEBUG shows audio levels, to help tune the two above.
LOG_LEVEL=INFO
