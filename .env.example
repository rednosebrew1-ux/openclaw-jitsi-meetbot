# Copy to .env and fill in. The voice server and the Jitsi bridge both read this file.

# ---- Required ----

# A long random secret shared by the voice server, the bridge and the OpenClaw skill.
# Make one with: openssl rand -hex 24
API_TOKEN=

# Your Jitsi Meet server. With docker-jitsi-meet on this Mac it's https://localhost:8443
# (or whatever you set as its PUBLIC_URL).
JITSI_URL=https://localhost:8443
# docker-jitsi-meet uses a self-signed certificate by default; let the bot accept it.
# Set to false once your server has a real certificate.
JITSI_IGNORE_TLS_ERRORS=true

# ---- The brain ----

# The OpenClaw Gateway's chat completions endpoint. Turn it on in OpenClaw with
#   openclaw config set gateway.http.endpoints.chatCompletions.enabled true
LLM_URL=http://127.0.0.1:18789/v1/chat/completions
# Your Gateway token (openclaw config get gateway.auth.token).
LLM_API_KEY=
# openclaw:<agentId>. The call goes through this agent, so it can use your other agents and tools.
LLM_MODEL=openclaw:main
# Any other OpenAI-compatible endpoint works too, e.g. Ollama:
#   LLM_URL=http://127.0.0.1:11434/v1/chat/completions
#   LLM_MODEL=llama3.1:8b
# (In Docker, use host.docker.internal instead of 127.0.0.1.)

AI_NAME=Assistant
GREETING=Hey, it's your assistant. What's up?
# SYSTEM_PROMPT=...   (the default asks for short spoken replies and <hangup/> at the end)

# ---- Rooms ----

# Always-on: the bot stays in this room all the time, and you join it whenever you want to talk.
# It greets you when you arrive, stays when you leave, and rejoins on its own if it gets dropped.
# "Call me" sends you this link instead of making a new room. Pick a name that's hard to guess:
# anyone who can reach your Jitsi server and knows the room can talk to your agent.
ALWAYS_ON_MEETING_URL=

# Without an always-on room, "call me" makes a fresh, random room on JITSI_URL each time.

# How long the bot waits in a room for you before giving up (seconds).
JOIN_TIMEOUT=180

# Optional: a push notification with the link when the AI calls you. Any URL that accepts
# a plain-text POST works; with ntfy (free app), use https://ntfy.sh/<a-long-random-topic-name>.
NOTIFY_URL=

# Optional: if the bot reaches your Jitsi server at a different address than you do (for
# example the bot in Docker), set that address here; room names stay the same.
# JITSI_INTERNAL_URL=https://host.docker.internal:8443

# Only when running in Docker (docker-compose.yml sets it already) or with the bridge on
# another computer: where the bridge finds the voice server.
# VOICE_URL=ws://127.0.0.1:8090/bridge

# ---- Speech ----

# Local and free by default. Models download into ./data on first use.
STT_BACKEND=faster-whisper
WHISPER_MODEL=base.en
TTS_BACKEND=piper
PIPER_VOICE=en_US-lessac-medium
# Or any OpenAI-compatible speech API:
#   STT_BACKEND=openai   STT_URL=...  STT_API_KEY=...  STT_MODEL=whisper-1
#   TTS_BACKEND=openai   TTS_URL=...  TTS_API_KEY=...  TTS_MODEL=gpt-4o-mini-tts  TTS_VOICE=alloy

# ---- Tuning ----

# Say a filler ("One sec.") if the brain takes longer than this; give up after LLM_TIMEOUT.
FILLER_DELAY=2.5
LLM_TIMEOUT=30
# Turn-taking: how long a pause ends your turn, and how long you must talk to interrupt.
SILENCE_MS=700
BARGE_IN_MS=300
# Show the bot's browser window (handy when something won't join).
JITSI_HEADLESS=true
# LOG_LEVEL=DEBUG shows audio levels, to help tune the two above.
LOG_LEVEL=INFO
